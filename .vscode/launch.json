{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python3.11 APKViewer .venv",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python3.11",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": [
                "/home/gmm/9.3.Alternative.apk"
            ],
            "preLaunchTask": "clear_pycache"
        },
        {
            "name": "Build APKViewer (Linux)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python3.11",
            "module": "nuitka",
            "console": "integratedTerminal",
            "args": [
                "--standalone",
                "--onefile",
                "--output-dir=dist",
                "--output-filename=APKViewer-linux.bin",
                "--include-package-data=androguard",
                "--include-package-data=ttkbootstrap",
                "--include-package-data=babel",
                "--include-data-dir=assets=assets",
                "--enable-plugin=tk-inter",
                "--enable-plugin=anti-bloat",
                "--nofollow-import-to=frida",
                "--static-libpython=no",
                "--lto=yes",
                "${workspaceFolder}/main.py"
            ],
        },
    ],
}